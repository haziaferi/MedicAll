<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Neither component reaches a release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A documents provider over app-private files, so the instrumented tests can open a Storage Access
             Framework tree without the system picker. It lists no roots, so no picker shows it, and
             MANAGE_DOCUMENTS (a system permission) keeps every other app out. -->
        <provider
            android:name=".StubDocumentsProvider"
            android:authorities="com.hazia.medicall.stubdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />

        <!-- The phase 1 harness (SPEC:R100): the debug build's launcher, so the two-phone walk starts it from
             the home screen. -->
        <activity
            android:name=".HarnessActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:label="MedicAll harness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Does nothing and closes. Started from adb to wake an instrumented run that OxygenOS's freezer stopped,
             without the harness, whose start-up clean-up would treat the tests' folders as orphans. -->
        <activity
            android:name=".WakeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- The Compose theme's preview (SPEC:R93): every palette in light and dark, from its own launcher icon. -->
        <activity
            android:name=".ThemePreviewActivity"
            android:exported="true"
            android:label="MedicAll theme"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
