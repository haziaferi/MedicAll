<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a documents provider over app-private files, so the instrumented tests can open a
     Storage Access Framework tree without the system picker. It lists no roots, so no picker shows it, and
     MANAGE_DOCUMENTS (a system permission) keeps every other app out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name=".StubDocumentsProvider"
            android:authorities="com.hazia.medicall.stubdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
    </application>
</manifest>
