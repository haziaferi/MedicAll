<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: the only network use is the medicine-list refresh, which arrives in phase 3 (SPEC:R12). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app lock's optional fingerprint, through the system's prompt (SPEC:R11). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- No Android backup: the sealed database key and the encrypted database stay on the device;
         MedicAll writes its own encrypted backups (SPEC:R10, SPEC:R22). -->
    <application
        android:allowBackup="false"
        android:label="MedicAll" />
</manifest>
